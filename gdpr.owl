<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/gdpr#" xml:base="http://example.org/gdpr"
 xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:owl="http://www.w3.org/2002/07/owl#"
 xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
  <owl:Ontology rdf:about="http://example.org/gdpr"><rdfs:comment>GDPR ontology for an offline RAG chatbot (educational).</rdfs:comment></owl:Ontology>
  <owl:Class rdf:about="#Actor"><rdfs:comment>A party defined by the GDPR.</rdfs:comment></owl:Class>
  <owl:Class rdf:about="#DataSubject"><rdfs:subClassOf rdf:resource="#Actor"/><rdfs:comment>Identified or identifiable natural person whose data is processed (Art. 4).</rdfs:comment></owl:Class>
  <owl:Class rdf:about="#Controller"><rdfs:subClassOf rdf:resource="#Actor"/><rdfs:comment>Determines the purposes and means of processing (Art. 4).</rdfs:comment></owl:Class>
  <owl:Class rdf:about="#Processor"><rdfs:subClassOf rdf:resource="#Actor"/><rdfs:comment>Processes personal data on behalf of the controller (Art. 4).</rdfs:comment></owl:Class>
  <owl:Class rdf:about="#DataProtectionOfficer"><rdfs:subClassOf rdf:resource="#Actor"/><rdfs:comment>Designated under Art. 37.</rdfs:comment></owl:Class>
  <owl:Class rdf:about="#SupervisoryAuthority"><rdfs:subClassOf rdf:resource="#Actor"/><rdfs:comment>Independent public authority (Art. 51).</rdfs:comment></owl:Class>
  <owl:Class rdf:about="#Right"><rdfs:comment>A right of the data subject (Chapter III).</rdfs:comment></owl:Class>
  <owl:Class rdf:about="#Obligation"><rdfs:comment>A duty of a controller or processor.</rdfs:comment></owl:Class>
  <owl:Class rdf:about="#LegalBasis"><rdfs:comment>A lawful basis for processing (Art. 6).</rdfs:comment></owl:Class>
  <owl:Class rdf:about="#Principle"><rdfs:comment>A principle relating to processing (Art. 5).</rdfs:comment></owl:Class>
  <owl:Class rdf:about="#Penalty"><rdfs:comment>An administrative fine tier (Art. 83).</rdfs:comment></owl:Class>
  <owl:Class rdf:about="#Event"><rdfs:comment>A situation that triggers an obligation.</rdfs:comment></owl:Class>
  <owl:Class rdf:about="#Article"><rdfs:comment>An article of Regulation (EU) 2016/679.</rdfs:comment></owl:Class>
  <owl:AllDisjointClasses><owl:members rdf:parseType="Collection"><rdf:Description rdf:about="#DataSubject"/><rdf:Description rdf:about="#Controller"/><rdf:Description rdf:about="#Processor"/><rdf:Description rdf:about="#DataProtectionOfficer"/><rdf:Description rdf:about="#SupervisoryAuthority"/></owl:members></owl:AllDisjointClasses>
  <owl:AllDisjointClasses><owl:members rdf:parseType="Collection"><rdf:Description rdf:about="#Actor"/><rdf:Description rdf:about="#Right"/><rdf:Description rdf:about="#Obligation"/><rdf:Description rdf:about="#LegalBasis"/><rdf:Description rdf:about="#Principle"/><rdf:Description rdf:about="#Penalty"/><rdf:Description rdf:about="#Event"/><rdf:Description rdf:about="#Article"/></owl:members></owl:AllDisjointClasses>
  <owl:ObjectProperty rdf:about="#hasRight"><rdfs:domain rdf:resource="#DataSubject"/><rdfs:range rdf:resource="#Right"/><owl:inverseOf rdf:resource="#rightOf"/><rdfs:comment>Data subject has this right.</rdfs:comment></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#rightOf"><rdfs:domain rdf:resource="#Right"/><rdfs:range rdf:resource="#DataSubject"/><rdfs:comment>Inverse of hasRight.</rdfs:comment></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#hasObligation"><rdfs:domain rdf:resource="#Actor"/><rdfs:range rdf:resource="#Obligation"/><rdfs:comment>Actor must fulfil this obligation.</rdfs:comment></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#definedIn"><rdfs:range rdf:resource="#Article"/><rdfs:comment>The article in which the concept is defined.</rdfs:comment></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#triggeredBy"><rdfs:domain rdf:resource="#Obligation"/><rdfs:range rdf:resource="#Event"/><rdfs:comment>Event that triggers the obligation.</rdfs:comment></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#notifies"><rdfs:domain rdf:resource="#Obligation"/><rdfs:range rdf:resource="#Actor"/><rdfs:comment>Who must be notified.</rdfs:comment></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#hasPenaltyTier"><rdfs:domain><owl:Class><owl:unionOf rdf:parseType="Collection"><rdf:Description rdf:about="#Obligation"/><rdf:Description rdf:about="#Right"/><rdf:Description rdf:about="#Principle"/></owl:unionOf></owl:Class></rdfs:domain><rdfs:range rdf:resource="#Penalty"/><rdfs:comment>Fine tier for infringements (Art. 83).</rdfs:comment></owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="#articleNumber"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><rdfs:comment>Number of the article.</rdfs:comment></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="#deadlineHours"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><rdfs:comment>Deadline in hours.</rdfs:comment></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="#maxFineEUR"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><rdfs:comment>Maximum fine in euro.</rdfs:comment></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="#maxFinePercent"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><rdfs:comment>Maximum fine as percent of worldwide annual turnover.</rdfs:comment></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="#description"><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:comment>Short plain-language description.</rdfs:comment></owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="#Art_5"><rdf:type rdf:resource="#Article"/><articleNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</articleNumber></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Art_6"><rdf:type rdf:resource="#Article"/><articleNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</articleNumber></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Art_7"><rdf:type rdf:resource="#Article"/><articleNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</articleNumber></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Art_12"><rdf:type rdf:resource="#Article"/><articleNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</articleNumber></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Art_15"><rdf:type rdf:resource="#Article"/><articleNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</articleNumber></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Art_16"><rdf:type rdf:resource="#Article"/><articleNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</articleNumber></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Art_17"><rdf:type rdf:resource="#Article"/><articleNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</articleNumber></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Art_18"><rdf:type rdf:resource="#Article"/><articleNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</articleNumber></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Art_20"><rdf:type rdf:resource="#Article"/><articleNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</articleNumber></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Art_21"><rdf:type rdf:resource="#Article"/><articleNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">21</articleNumber></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Art_22"><rdf:type rdf:resource="#Article"/><articleNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22</articleNumber></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Art_30"><rdf:type rdf:resource="#Article"/><articleNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30</articleNumber></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Art_33"><rdf:type rdf:resource="#Article"/><articleNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">33</articleNumber></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Art_34"><rdf:type rdf:resource="#Article"/><articleNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">34</articleNumber></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Art_35"><rdf:type rdf:resource="#Article"/><articleNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35</articleNumber></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Art_37"><rdf:type rdf:resource="#Article"/><articleNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">37</articleNumber></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Art_83"><rdf:type rdf:resource="#Article"/><articleNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">83</articleNumber></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#RightOfAccess"><rdf:type rdf:resource="#Right"/><definedIn rdf:resource="#Art_15"/><hasPenaltyTier rdf:resource="#FineTier2"/><description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Right to obtain confirmation of processing and access to the personal data.</description><rdfs:label>right of access</rdfs:label><rdfs:label>right to access</rdfs:label><rdfs:label>access my data</rdfs:label><rdfs:label>access to my data</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#RightToRectification"><rdf:type rdf:resource="#Right"/><definedIn rdf:resource="#Art_16"/><hasPenaltyTier rdf:resource="#FineTier2"/><description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Right to have inaccurate personal data corrected.</description><rdfs:label>right to rectification</rdfs:label><rdfs:label>rectification</rdfs:label><rdfs:label>correct my data</rdfs:label><rdfs:label>inaccurate data</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#RightToErasure"><rdf:type rdf:resource="#Right"/><definedIn rdf:resource="#Art_17"/><hasPenaltyTier rdf:resource="#FineTier2"/><description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Right to have personal data erased in certain situations ('right to be forgotten').</description><rdfs:label>right to erasure</rdfs:label><rdfs:label>erasure</rdfs:label><rdfs:label>right to be forgotten</rdfs:label><rdfs:label>be forgotten</rdfs:label><rdfs:label>delete my data</rdfs:label><rdfs:label>deletion</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#RightToRestriction"><rdf:type rdf:resource="#Right"/><definedIn rdf:resource="#Art_18"/><hasPenaltyTier rdf:resource="#FineTier2"/><description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Right to restrict processing in certain situations.</description><rdfs:label>right to restriction</rdfs:label><rdfs:label>restriction of processing</rdfs:label><rdfs:label>restrict processing</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#RightToPortability"><rdf:type rdf:resource="#Right"/><definedIn rdf:resource="#Art_20"/><hasPenaltyTier rdf:resource="#FineTier2"/><description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Right to receive personal data in a structured, commonly used, machine-readable format and transmit it to another controller.</description><rdfs:label>right to data portability</rdfs:label><rdfs:label>data portability</rdfs:label><rdfs:label>portability</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#RightToObject"><rdf:type rdf:resource="#Right"/><definedIn rdf:resource="#Art_21"/><hasPenaltyTier rdf:resource="#FineTier2"/><description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Right to object to processing, including for direct marketing.</description><rdfs:label>right to object</rdfs:label><rdfs:label>object to processing</rdfs:label><rdfs:label>objection</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#AnyDataSubject"><rdf:type rdf:resource="#DataSubject"/><hasRight rdf:resource="#RightOfAccess"/><hasRight rdf:resource="#RightToRectification"/><hasRight rdf:resource="#RightToErasure"/><hasRight rdf:resource="#RightToRestriction"/><hasRight rdf:resource="#RightToPortability"/><hasRight rdf:resource="#RightToObject"/><rdfs:label>data subject</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#PersonalDataBreach"><rdf:type rdf:resource="#Event"/><description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A breach of security leading to accidental or unlawful destruction, loss, alteration, unauthorised disclosure of, or access to personal data.</description><rdfs:label>personal data breach</rdfs:label><rdfs:label>data breach</rdfs:label><rdfs:label>breach</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#TheAuthority"><rdf:type rdf:resource="#SupervisoryAuthority"/><rdfs:label>supervisory authority</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#BreachNotificationToAuthority"><rdf:type rdf:resource="#Obligation"/><definedIn rdf:resource="#Art_33"/><hasPenaltyTier rdf:resource="#FineTier1"/><description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Notify the supervisory authority of a personal data breach without undue delay and, where feasible, not later than 72 hours after becoming aware of it, unless it is unlikely to result in a risk to the rights and freedoms of natural persons.</description><deadlineHours rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">72</deadlineHours><triggeredBy rdf:resource="#PersonalDataBreach"/><notifies rdf:resource="#TheAuthority"/><rdfs:label>breach notification</rdfs:label><rdfs:label>notify the supervisory authority</rdfs:label><rdfs:label>notification to the authority</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#BreachNotificationToDataSubject"><rdf:type rdf:resource="#Obligation"/><definedIn rdf:resource="#Art_34"/><hasPenaltyTier rdf:resource="#FineTier1"/><description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Communicate a personal data breach to the data subject when it is likely to result in a high risk to their rights and freedoms.</description><triggeredBy rdf:resource="#PersonalDataBreach"/><notifies rdf:resource="#AnyDataSubject"/><rdfs:label>communicate a personal data breach</rdfs:label><rdfs:label>notify the data subject</rdfs:label><rdfs:label>inform the data subject of a breach</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#RecordsOfProcessing"><rdf:type rdf:resource="#Obligation"/><definedIn rdf:resource="#Art_30"/><hasPenaltyTier rdf:resource="#FineTier1"/><description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Maintain records of processing activities.</description><rdfs:label>records of processing</rdfs:label><rdfs:label>record keeping</rdfs:label><rdfs:label>processing records</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#DataProtectionImpactAssessment"><rdf:type rdf:resource="#Obligation"/><definedIn rdf:resource="#Art_35"/><hasPenaltyTier rdf:resource="#FineTier1"/><description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Carry out an assessment of the impact of the envisaged processing before it starts, where it is likely to result in a high risk to the rights and freedoms of natural persons.</description><rdfs:label>data protection impact assessment</rdfs:label><rdfs:label>impact assessment</rdfs:label><rdfs:label>dpia</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#DesignateDPO"><rdf:type rdf:resource="#Obligation"/><definedIn rdf:resource="#Art_37"/><hasPenaltyTier rdf:resource="#FineTier1"/><description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Designate a data protection officer, for example where core activities involve regular and systematic monitoring of data subjects on a large scale.</description><rdfs:label>data protection officer</rdfs:label><rdfs:label>dpo</rdfs:label><rdfs:label>designate a dpo</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#TheController"><rdf:type rdf:resource="#Controller"/><hasObligation rdf:resource="#BreachNotificationToAuthority"/><hasObligation rdf:resource="#BreachNotificationToDataSubject"/><hasObligation rdf:resource="#RecordsOfProcessing"/><hasObligation rdf:resource="#DataProtectionImpactAssessment"/><hasObligation rdf:resource="#DesignateDPO"/><rdfs:label>controller</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#LawfulnessFairnessTransparency"><rdf:type rdf:resource="#Principle"/><definedIn rdf:resource="#Art_5"/><hasPenaltyTier rdf:resource="#FineTier2"/><rdfs:label>lawfulness</rdfs:label><rdfs:label>fairness</rdfs:label><rdfs:label>transparency</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#PurposeLimitation"><rdf:type rdf:resource="#Principle"/><definedIn rdf:resource="#Art_5"/><hasPenaltyTier rdf:resource="#FineTier2"/><rdfs:label>purpose limitation</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#DataMinimisation"><rdf:type rdf:resource="#Principle"/><definedIn rdf:resource="#Art_5"/><hasPenaltyTier rdf:resource="#FineTier2"/><rdfs:label>data minimisation</rdfs:label><rdfs:label>data minimization</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Accuracy"><rdf:type rdf:resource="#Principle"/><definedIn rdf:resource="#Art_5"/><hasPenaltyTier rdf:resource="#FineTier2"/><rdfs:label>accuracy</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#StorageLimitation"><rdf:type rdf:resource="#Principle"/><definedIn rdf:resource="#Art_5"/><hasPenaltyTier rdf:resource="#FineTier2"/><rdfs:label>storage limitation</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#IntegrityAndConfidentiality"><rdf:type rdf:resource="#Principle"/><definedIn rdf:resource="#Art_5"/><hasPenaltyTier rdf:resource="#FineTier2"/><rdfs:label>integrity and confidentiality</rdfs:label><rdfs:label>confidentiality</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Accountability"><rdf:type rdf:resource="#Principle"/><definedIn rdf:resource="#Art_5"/><hasPenaltyTier rdf:resource="#FineTier2"/><rdfs:label>accountability</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Consent"><rdf:type rdf:resource="#LegalBasis"/><definedIn rdf:resource="#Art_6"/><rdfs:label>consent</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Contract"><rdf:type rdf:resource="#LegalBasis"/><definedIn rdf:resource="#Art_6"/><rdfs:label>contract</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#LegalObligation"><rdf:type rdf:resource="#LegalBasis"/><definedIn rdf:resource="#Art_6"/><rdfs:label>legal obligation</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#VitalInterests"><rdf:type rdf:resource="#LegalBasis"/><definedIn rdf:resource="#Art_6"/><rdfs:label>vital interests</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#PublicTask"><rdf:type rdf:resource="#LegalBasis"/><definedIn rdf:resource="#Art_6"/><rdfs:label>public task</rdfs:label><rdfs:label>public interest</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#LegitimateInterests"><rdf:type rdf:resource="#LegalBasis"/><definedIn rdf:resource="#Art_6"/><rdfs:label>legitimate interests</rdfs:label><rdfs:label>legitimate interest</rdfs:label></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#FineTier1"><rdf:type rdf:resource="#Penalty"/><maxFineEUR rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10000000</maxFineEUR><maxFinePercent rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</maxFinePercent><definedIn rdf:resource="#Art_83"/><description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 83(4): up to 10 000 000 EUR or 2 % of worldwide annual turnover, whichever is higher.</description></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#FineTier2"><rdf:type rdf:resource="#Penalty"/><maxFineEUR rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20000000</maxFineEUR><maxFinePercent rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</maxFinePercent><definedIn rdf:resource="#Art_83"/><description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art. 83(5): up to 20 000 000 EUR or 4 % of worldwide annual turnover, whichever is higher.</description></owl:NamedIndividual>
</rdf:RDF>
